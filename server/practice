//for read file data using stream

const fs = require("fs");
const readStream = fs.createReadStream("a.txt", "utf-8");
readStream.on("data", (chunk) => {
  console.log("Data chunk received:");
  console.log(chunk);
});

readStream.on("end", () => {
  console.log("Finished reading file.");
});

//for write file data using stream
const readStream1 = fs.createReadStream("a.txt", "utf-8");
const writeStream = fs.createWriteStream("output.txt", "utf-8");
readStream.pipe(writeStream);
console.log("✅ File copied from input.txt to output.txt successfully!");
